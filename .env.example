# Copy to .env.local for development. Every variable without a default is required at boot.

# Arc mainnet JSON-RPC. The public endpoint rate-limits bursts (HTTP 429); a provider endpoint
# (Alchemy, QuickNode, dRPC, Blockdaemon) is recommended for the deployed app.
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Must equal eth_chainId of ARC_RPC_URL; checked on first use.
ARC_CHAIN_ID=5042

# SQLite file for the report cache, attestations and rate limits.
DATABASE_PATH=./data/centscan.db

SOURCIFY_URL=https://sourcify.dev/server
SIGNATURE_DB_URL=https://api.openchain.xyz/signature-database/v1

# Deployed CentscanRegistry and the official attester. Leave REGISTRY_ADDRESS empty until the
# contract is deployed: reports and badges work, attestation is disabled with an explanation.
REGISTRY_ADDRESS=
ATTESTER_ADDRESS=
# Secret. Set only in .env.local or the host's secret store; never commit it.
ATTESTER_PRIVATE_KEY=

# Optional tuning (defaults shown). The public RPC meters every call in a batch. On 14 Oct 2026 it
# sustained 10 calls/s with zero errors and returned -32005 "rate limit exceeded" at 12-30 calls/s.
# A report needs ~2 calls per transaction, so 150 transactions take ~30 s on the public RPC.
# With a provider endpoint, raise all three (e.g. 200 / 400 / 2000).
RPC_MAX_CALLS_PER_SECOND=10
RPC_BURST=25
# Event-less contracts are found by reading whole blocks, one RPC call per block: 300 blocks (~2.5 min of chain
# time) take ~30 s on the public RPC. Raise to 10000 with a provider RPC.
SCAN_FALLBACK_BLOCKS=300
MAX_TXS_PER_REPORT=150
LOG_LEVEL=info
